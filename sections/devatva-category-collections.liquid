{% comment %}
  DEVATVA.IN - SACRED COLLECTIONS CATALOG (ALL 20 AUMCHAKRA ITEMS MAPPED INTO 4 CATEGORIES)
{% endcomment %}

<div style="padding: 70px 20px; background: #fffcf7; border-bottom: 1.5px solid var(--dev-gold-border);">
  <div style="max-width: 1250px; margin: 0 auto;">
    
    <div style="text-align: center; margin-bottom: 44px;">
      <span class="devatva-badge devatva-badge-glowing" style="margin-bottom: 10px;">📿 Divine Catalog Collections</span>
      <h2 class="devatva-heading" style="font-size: clamp(1.8rem, 4vw, 2.7rem); color: #1c1917;">
        Shop by <span class="devatva-gold-text">Sacred Collection</span>
      </h2>
      <p style="color: #57534e; font-size: 1rem; max-width: 650px; margin: 8px auto 0 auto;">
        Explore authentic Rudraksha beads, Zodiac & Numerology crystal bracelets, Panchdhatu wealth rings, and brass Yantras.
      </p>
    </div>

    <!-- 4 Main Category Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;">
      
      <!-- 1. BRACELETS & PI-XIU -->
      <div style="background: #ffffff; border: 1.5px solid var(--dev-gold-border); border-radius: 18px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); display: flex; flex-direction: column;">
        <div style="font-size: 2.8rem; margin-bottom: 12px; line-height: 1;">📿</div>
        <h3 class="devatva-heading" style="font-size: 1.3rem; color: #1c1917; margin-bottom: 8px;">BRACELETS & PI-XIU</h3>
        <p style="font-size: 0.84rem; color: #57534e; line-height: 1.45; margin-bottom: 16px;">Spiritual, Zodiac, Numerology, Pi-Xiu, Daily Essentials, and Best Seller Bracelets.</p>
        
        <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.86rem; color: var(--dev-gold-dark); display: flex; flex-direction: column; gap: 6px; font-weight: 700;">
          <li><a href="/collections/bracelets" style="color: inherit; text-decoration: none;">▸ BRACELETS</a></li>
          <li><a href="/collections/zodiac-bracelets" style="color: inherit; text-decoration: none;">▸ ZODIAC BRACELETS</a></li>
          <li><a href="/collections/numerology-bracelets" style="color: inherit; text-decoration: none;">▸ NUMEROLOGY BRACELETS</a></li>
          <li><a href="/collections/pi-xiu-bracelets" style="color: inherit; text-decoration: none;">▸ PI-XIU BRACELETS</a></li>
          <li><a href="/collections/daily-essentials" style="color: inherit; text-decoration: none;">▸ DAILY ESSENTIALS</a></li>
          <li><a href="/collections/best-seller" style="color: inherit; text-decoration: none;">▸ BEST SELLER</a></li>
        </ul>

        <a href="/collections/bracelets" class="devatva-gold-btn" style="margin-top: auto; padding: 11px; font-size: 0.88rem;">
          Explore Bracelets ➔
        </a>
      </div>

      <!-- 2. RINGS & PENDANTS -->
      <div style="background: #ffffff; border: 1.5px solid var(--dev-gold-border); border-radius: 18px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); display: flex; flex-direction: column;">
        <div style="font-size: 2.8rem; margin-bottom: 12px; line-height: 1;">💰</div>
        <h3 class="devatva-heading" style="font-size: 1.3rem; color: #1c1917; margin-bottom: 8px;">RINGS & PENDANTS</h3>
        <p style="font-size: 0.84rem; color: #57534e; line-height: 1.45; margin-bottom: 16px;">Crystal Rings, Pi-Xiu Rings, Gem Rings, and Energized Spiritual Pendants.</p>

        <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.86rem; color: var(--dev-gold-dark); display: flex; flex-direction: column; gap: 6px; font-weight: 700;">
          <li><a href="/collections/crystal-rings" style="color: inherit; text-decoration: none;">▸ CRYSTAL RINGS</a></li>
          <li><a href="/collections/pi-xiu-rings" style="color: inherit; text-decoration: none;">▸ PI-XIU RINGS</a></li>
          <li><a href="/collections/gem-rings" style="color: inherit; text-decoration: none;">▸ GEM RINGS</a></li>
          <li><a href="/collections/pendants" style="color: inherit; text-decoration: none;">▸ PENDANTS</a></li>
        </ul>

        <a href="/collections/rings" class="devatva-gold-btn" style="margin-top: auto; padding: 11px; font-size: 0.88rem;">
          Explore Rings ➔
        </a>
      </div>

      <!-- 3. RUDRAKSHA & MALAS -->
      <div style="background: #ffffff; border: 1.5px solid var(--dev-gold-border); border-radius: 18px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); display: flex; flex-direction: column;">
        <div style="font-size: 2.8rem; margin-bottom: 12px; line-height: 1;">🔱</div>
        <h3 class="devatva-heading" style="font-size: 1.3rem; color: #1c1917; margin-bottom: 8px;">RUDRAKSHA & MALAS</h3>
        <p style="font-size: 0.84rem; color: #57534e; line-height: 1.45; margin-bottom: 16px;">1-14 Mukhi Rudraksha, Karungalis, 108 Jaap Malas, and Loose Gemstones.</p>

        <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.86rem; color: var(--dev-gold-dark); display: flex; flex-direction: column; gap: 6px; font-weight: 700;">
          <li><a href="/collections/rudraksha-karungalis" style="color: inherit; text-decoration: none;">▸ RUDRAKSHA & KARUNGALIS</a></li>
          <li><a href="/collections/jaap-malas" style="color: inherit; text-decoration: none;">▸ JAAP MALAS</a></li>
          <li><a href="/collections/gemstones" style="color: inherit; text-decoration: none;">▸ GEMSTONES</a></li>
        </ul>

        <a href="/collections/rudraksha" class="devatva-gold-btn" style="margin-top: auto; padding: 11px; font-size: 0.88rem;">
          Explore Rudraksha ➔
        </a>
      </div>

      <!-- 4. PYRAMIDS, TREES & POOJA -->
      <div style="background: #ffffff; border: 1.5px solid var(--dev-gold-border); border-radius: 18px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); display: flex; flex-direction: column;">
        <div style="font-size: 2.8rem; margin-bottom: 12px; line-height: 1;">🪔</div>
        <h3 class="devatva-heading" style="font-size: 1.3rem; color: #1c1917; margin-bottom: 8px;">PYRAMIDS, TREES & POOJA</h3>
        <p style="font-size: 0.84rem; color: #57534e; line-height: 1.45; margin-bottom: 16px;">Pyramids, Pyrite Frames, Crystal Trees, Guasha, Divine Idols & Water Bottles.</p>

        <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.86rem; color: var(--dev-gold-dark); display: flex; flex-direction: column; gap: 6px; font-weight: 700;">
          <li><a href="/collections/pyramid-rows" style="color: inherit; text-decoration: none;">▸ PYRAMID & ROWS</a></li>
          <li><a href="/collections/pyrite-frames" style="color: inherit; text-decoration: none;">▸ PYRITE FRAMES</a></li>
          <li><a href="/collections/crystal-trees" style="color: inherit; text-decoration: none;">▸ CRYSTAL TREES</a></li>
          <li><a href="/collections/roller-guashas" style="color: inherit; text-decoration: none;">▸ ROLLER & GUASHAS</a></li>
          <li><a href="/collections/god-divine-idols" style="color: inherit; text-decoration: none;">▸ GOD DIVINE IDOLS</a></li>
          <li><a href="/collections/crystal-water-bottles" style="color: inherit; text-decoration: none;">▸ CRYSTAL WATER BOTTLES</a></li>
        </ul>

        <a href="/collections/pyramids-pooja" class="devatva-gold-btn" style="margin-top: auto; padding: 11px; font-size: 0.88rem;">
          Explore Pyramids & Pooja ➔
        </a>
      </div>

    </div>

  </div>
</div>

