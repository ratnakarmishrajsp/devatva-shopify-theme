{% comment %}
  DEVATVA.IN - SACRED COLLECTIONS CATALOG (AUMCHAKRA INSPIRED)
  Organized collection cards matching aumchakra.com product taxonomy
{% endcomment %}

<div style="padding: 70px 20px; background: #fffcf7; border-bottom: 1.5px solid var(--dev-gold-border);">
  <div style="max-width: 1250px; margin: 0 auto;">
    
    <div style="text-align: center; margin-bottom: 44px;">
      <span class="devatva-badge devatva-badge-glowing" style="margin-bottom: 10px;">📿 Divine Catalog Collections</span>
      <h2 class="devatva-heading" style="font-size: clamp(1.8rem, 4vw, 2.7rem); color: #1c1917;">
        Shop by <span class="devatva-gold-text">Sacred Collection</span>
      </h2>
      <p style="color: #57534e; font-size: 1rem; max-width: 650px; margin: 8px auto 0 auto;">
        Explore lab-certified Rudraksha, Zodiac & Numerology crystal bracelets, Panchdhatu wealth rings, and brass Yantras.
      </p>
    </div>

    <!-- Category Grid matching aumchakra.com -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 22px;">
      
      <!-- Collection 1: Zodiac & Numerology Bracelets -->
      <div style="background: #ffffff; border: 1.5px solid var(--dev-gold-border); border-radius: 18px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); display: flex; flex-direction: column;">
        <div style="font-size: 2.8rem; margin-bottom: 12px; line-height: 1;">✨</div>
        <h3 class="devatva-heading" style="font-size: 1.25rem; color: #1c1917; margin-bottom: 8px;">Zodiac & Numerology</h3>
        <p style="font-size: 0.84rem; color: #57534e; line-height: 1.45; margin-bottom: 16px;">Rashi & birth-number specific lucky crystal bracelets energized for personal destiny.</p>
        
        <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.85rem; color: var(--dev-gold-dark); display: flex; flex-direction: column; gap: 6px;">
          <li><a href="{{ routes.all_products_collection_url }}/zodiac-bracelets" style="color: inherit; text-decoration: none;">▸ 12 Rashi Zodiac Bracelets</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/numerology-bracelets" style="color: inherit; text-decoration: none;">▸ Numerology Lucky Bracelets</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/rashi-gemstones" style="color: inherit; text-decoration: none;">▸ Planetary Alignment Gems</a></li>
        </ul>

        <a href="{{ routes.all_products_collection_url }}/zodiac-bracelets" class="devatva-gold-btn" style="margin-top: auto; padding: 10px; font-size: 0.85rem;">
          Explore Zodiac ➔
        </a>
      </div>

      <!-- Collection 2: Healing Crystal & Nazar Bracelets -->
      <div style="background: #ffffff; border: 1.5px solid var(--dev-gold-border); border-radius: 18px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); display: flex; flex-direction: column;">
        <div style="font-size: 2.8rem; margin-bottom: 12px; line-height: 1;">🔮</div>
        <h3 class="devatva-heading" style="font-size: 1.25rem; color: #1c1917; margin-bottom: 8px;">Healing & Nazar Shields</h3>
        <p style="font-size: 0.84rem; color: #57534e; line-height: 1.45; margin-bottom: 16px;">7 Chakra balancing, Black Tourmaline Nazar Protection, and Pyrite Money bracelets.</p>

        <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.85rem; color: var(--dev-gold-dark); display: flex; flex-direction: column; gap: 6px;">
          <li><a href="{{ routes.all_products_collection_url }}/7-chakra" style="color: inherit; text-decoration: none;">▸ 7 Chakra Balancing Bracelets</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/black-tourmaline" style="color: inherit; text-decoration: none;">▸ Black Tourmaline Nazar Shield</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/pyrite" style="color: inherit; text-decoration: none;">▸ Pyrite Prosperity Bracelets</a></li>
        </ul>

        <a href="{{ routes.all_products_collection_url }}/healing-bracelets" class="devatva-gold-btn" style="margin-top: auto; padding: 10px; font-size: 0.85rem;">
          Explore Crystals ➔
        </a>
      </div>

      <!-- Collection 3: Rudraksha & Karungali -->
      <div style="background: #ffffff; border: 1.5px solid var(--dev-gold-border); border-radius: 18px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); display: flex; flex-direction: column;">
        <div style="font-size: 2.8rem; margin-bottom: 12px; line-height: 1;">🔱</div>
        <h3 class="devatva-heading" style="font-size: 1.25rem; color: #1c1917; margin-bottom: 8px;">Rudraksha & Karungali</h3>
        <p style="font-size: 0.84rem; color: #57534e; line-height: 1.45; margin-bottom: 16px;">1 to 14 Mukhi Siddha Rudraksha, Silver Capped Bracelets, and Karungali Wood Malas.</p>

        <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.85rem; color: var(--dev-gold-dark); display: flex; flex-direction: column; gap: 6px;">
          <li><a href="{{ routes.all_products_collection_url }}/rudraksha-bracelets" style="color: inherit; text-decoration: none;">▸ 5 Mukhi Silver Bracelets</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/1-14-mukhi-rudraksha" style="color: inherit; text-decoration: none;">▸ 1-14 Mukhi Siddha Beads</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/karungali-malas" style="color: inherit; text-decoration: none;">▸ Karungali Wood Malas</a></li>
        </ul>

            <a href="{% if collection != blank %}{{ collection.url }}{% else %}{{ block.settings.link }}{% endif %}" class="devatva-gold-btn" style="margin-top: auto; padding: 10px; font-size: 0.85rem;">
              Explore Collection ➔
            </a>
          </div>
        {%- endfor -%}
      {%- else -%}

      <!-- Collection 4: Panchdhatu Rings & Copper Kadas -->
      <div style="background: #ffffff; border: 1.5px solid var(--dev-gold-border); border-radius: 18px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); display: flex; flex-direction: column;">
        <div style="font-size: 2.8rem; margin-bottom: 12px; line-height: 1;">💰</div>
        <h3 class="devatva-heading" style="font-size: 1.25rem; color: #1c1917; margin-bottom: 8px;">Rings & Kadas</h3>
        <p style="font-size: 0.84rem; color: #57534e; line-height: 1.45; margin-bottom: 16px;">Panchdhatu Pixiu Wealth Rings, Sri Yantra Rings, and Pure Copper Mahadev Kadas.</p>

        <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.85rem; color: var(--dev-gold-dark); display: flex; flex-direction: column; gap: 6px;">
          <li><a href="{{ routes.all_products_collection_url }}/pixiu-ring" style="color: inherit; text-decoration: none;">▸ Panchdhatu Pixiu Wealth Ring</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/sri-yantra-ring" style="color: inherit; text-decoration: none;">▸ Sri Yantra Abundance Ring</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/mahadev-kada" style="color: inherit; text-decoration: none;">▸ Pure Copper Trishul Kada</a></li>
        </ul>

        <a href="{{ routes.all_products_collection_url }}/rings-kadas" class="devatva-gold-btn" style="margin-top: auto; padding: 10px; font-size: 0.85rem;">
          Explore Rings & Kadas ➔
        </a>
      </div>

      <!-- Collection 5: Pyramids, Yantras & Pooja Essentials -->
      <div style="background: #ffffff; border: 1.5px solid var(--dev-gold-border); border-radius: 18px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); display: flex; flex-direction: column;">
        <div style="font-size: 2.8rem; margin-bottom: 12px; line-height: 1;">🪔</div>
        <h3 class="devatva-heading" style="font-size: 1.25rem; color: #1c1917; margin-bottom: 8px;">Pyramids & Yantras</h3>
        <p style="font-size: 0.84rem; color: #57534e; line-height: 1.45; margin-bottom: 16px;">Energized Brass Yantras, Orgone Pyramids, Sphatik Malas, and Gemstone Trees.</p>

        <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.85rem; color: var(--dev-gold-dark); display: flex; flex-direction: column; gap: 6px;">
          <li><a href="{{ routes.all_products_collection_url }}/brass-yantras" style="color: inherit; text-decoration: none;">▸ Shree & Kubera Brass Yantras</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/crystal-pyramids" style="color: inherit; text-decoration: none;">▸ Orgone Crystal Pyramids</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/crystal-trees" style="color: inherit; text-decoration: none;">▸ Gemstone Prosperity Trees</a></li>
        </ul>

        <a href="{{ routes.all_products_collection_url }}/pooja-essentials" class="devatva-gold-btn" style="margin-top: auto; padding: 10px; font-size: 0.85rem;">
          Explore Yantras ➔
        </a>
      </div>

    </div>

  </div>
</div>

