        <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.86rem; color: var(--dev-gold-dark); display: flex; flex-direction: column; gap: 6px;">
          <li><a href="{{ routes.all_products_collection_url }}/zodiac-bracelets" style="color: inherit; text-decoration: none;">▸ Zodiac & Rashi Bracelets</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/numerology-bracelets" style="color: inherit; text-decoration: none;">▸ Numerology Lucky Bracelets</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/healing-crystal-bracelets" style="color: inherit; text-decoration: none;">▸ Healing Crystal Bracelets</a></li>
