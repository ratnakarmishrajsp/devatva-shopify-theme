{% comment %}
  DEVATVA.IN - SACRED COLLECTIONS MENU & CATEGORY GRID (OS 2.0)
  Matches category hierarchy of aumchakra.com with luxury Devatva light gold styling
{% endcomment %}

<div style="padding: 70px 20px; background: #fffcf7; border-bottom: 1.5px solid var(--dev-gold-border);">
  <div style="max-width: 1250px; margin: 0 auto;">
    
    <div style="text-align: center; margin-bottom: 44px;">
      <span class="devatva-badge devatva-badge-glowing" style="margin-bottom: 10px;">📿 Divine Catalog Categories</span>
      <h2 class="devatva-heading" style="font-size: clamp(1.8rem, 4vw, 2.7rem); color: #1c1917;">
        Shop by <span class="devatva-gold-text">Sacred Category</span>
      </h2>
      <p style="color: #57534e; font-size: 1rem; max-width: 650px; margin: 8px auto 0 auto;">
        Explore lab-certified Rudraksha, Panchdhatu wealth rings, copper kadas, and energized crystal gemstones.
      </p>
    </div>

    <!-- Main Category Grid (5 Core Categories) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 22px;">
      
      <!-- Category 1: Rudraksha & Karungali -->
      <div style="background: #ffffff; border: 1.5px solid var(--dev-gold-border); border-radius: 18px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: all 0.3s ease; display: flex; flex-direction: column;" class="devatva-category-card">
        <div style="font-size: 2.8rem; margin-bottom: 12px; line-height: 1;">🔱</div>
        <h3 class="devatva-heading" style="font-size: 1.25rem; color: #1c1917; margin-bottom: 8px;">Rudraksha & Karungali</h3>
        <p style="font-size: 0.84rem; color: #57534e; line-height: 1.45; margin-bottom: 16px;">1 to 14 Mukhi Siddha Rudraksha, 108 Jaap Malas, and Silver Capped Bracelets.</p>
        
        <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.85rem; color: var(--dev-gold-dark); display: flex; flex-direction: column; gap: 6px;">
          <li><a href="/collections/rudraksha-bracelets" style="color: inherit; text-decoration: none;">▸ 5 Mukhi Silver Bracelets</a></li>
          <li><a href="/collections/1-14-mukhi-rudraksha" style="color: inherit; text-decoration: none;">▸ 1-14 Mukhi Siddha Beads</a></li>
          <li><a href="/collections/gauri-shankar" style="color: inherit; text-decoration: none;">▸ Gauri Shankar & Ganesh</a></li>
          <li><a href="/collections/karungali-beads" style="color: inherit; text-decoration: none;">▸ Karungali Wood Malas</a></li>
        </ul>

        <a href="/collections/rudraksha" class="devatva-gold-btn" style="margin-top: auto; padding: 10px; font-size: 0.85rem;">
          Explore Rudraksha ➔
        </a>
      </div>

      <!-- Category 2: Feng Shui & Panchdhatu Rings -->
      <div style="background: #ffffff; border: 1.5px solid var(--dev-gold-border); border-radius: 18px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: all 0.3s ease; display: flex; flex-direction: column;" class="devatva-category-card">
        <div style="font-size: 2.8rem; margin-bottom: 12px; line-height: 1;">💰</div>
        <h3 class="devatva-heading" style="font-size: 1.25rem; color: #1c1917; margin-bottom: 8px;">Panchdhatu Rings</h3>
        <p style="font-size: 0.84rem; color: #57534e; line-height: 1.45; margin-bottom: 16px;">Panchdhatu wealth rings, Sri Yantra abundance rings, and Kachua (Turtle) rings.</p>

        <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.85rem; color: var(--dev-gold-dark); display: flex; flex-direction: column; gap: 6px;">
          <li><a href="/collections/pixiu-rings" style="color: inherit; text-decoration: none;">▸ Pixiu Wealth Rings</a></li>
          <li><a href="/collections/sri-yantra-rings" style="color: inherit; text-decoration: none;">▸ Sri Yantra Rings</a></li>
          <li><a href="/collections/kachua-rings" style="color: inherit; text-decoration: none;">▸ Turtle Abundance Rings</a></li>
          <li><a href="/collections/navratna-rings" style="color: inherit; text-decoration: none;">▸ Navratna Energy Rings</a></li>
        </ul>

        <a href="/collections/rings" class="devatva-gold-btn" style="margin-top: auto; padding: 10px; font-size: 0.85rem;">
          Explore Rings ➔
        </a>
      </div>

      <!-- Category 3: Pure Copper & Sacred Kadas -->
      <div style="background: #ffffff; border: 1.5px solid var(--dev-gold-border); border-radius: 18px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: all 0.3s ease; display: flex; flex-direction: column;" class="devatva-category-card">
        <div style="font-size: 2.8rem; margin-bottom: 12px; line-height: 1;">⚡</div>
        <h3 class="devatva-heading" style="font-size: 1.25rem; color: #1c1917; margin-bottom: 8px;">Pure Copper Kadas</h3>
        <p style="font-size: 0.84rem; color: #57534e; line-height: 1.45; margin-bottom: 16px;">Pure copper Mahadev Om Trishul kadas & Panchdhatu bio-electricity bangles.</p>

        <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.85rem; color: var(--dev-gold-dark); display: flex; flex-direction: column; gap: 6px;">
          <li><a href="/collections/mahadev-copper-kada" style="color: inherit; text-decoration: none;">▸ Mahadev Om Trishul Kada</a></li>
          <li><a href="/collections/panchdhatu-kada" style="color: inherit; text-decoration: none;">▸ Panchdhatu Bio Kada</a></li>
          <li><a href="/collections/brass-kada" style="color: inherit; text-decoration: none;">▸ Heavy Brass Engraved Kadas</a></li>
          <li><a href="/collections/nazar-kada" style="color: inherit; text-decoration: none;">▸ Black Thread Copper Kadas</a></li>
        </ul>

        <a href="/collections/kadas" class="devatva-gold-btn" style="margin-top: auto; padding: 10px; font-size: 0.85rem;">
          Explore Kadas ➔
        </a>
      </div>

      <!-- Category 4: Gemstone & Crystal Bracelets -->
      <div style="background: #ffffff; border: 1.5px solid var(--dev-gold-border); border-radius: 18px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: all 0.3s ease; display: flex; flex-direction: column;" class="devatva-category-card">
        <div style="font-size: 2.8rem; margin-bottom: 12px; line-height: 1;">🔮</div>
        <h3 class="devatva-heading" style="font-size: 1.25rem; color: #1c1917; margin-bottom: 8px;">Healing Crystals</h3>
        <p style="font-size: 0.84rem; color: #57534e; line-height: 1.45; margin-bottom: 16px;">7 Chakra balancing, Black Tourmaline Nazar Raksha, and Pyrite prosperity bracelets.</p>

        <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.85rem; color: var(--dev-gold-dark); display: flex; flex-direction: column; gap: 6px;">
          <li><a href="/collections/7-chakra-bracelets" style="color: inherit; text-decoration: none;">▸ 7 Chakra Bracelets</a></li>
          <li><a href="/collections/nazar-raksha-tourmaline" style="color: inherit; text-decoration: none;">▸ Black Tourmaline Nazar Shield</a></li>
          <li><a href="/collections/pyrite-bracelets" style="color: inherit; text-decoration: none;">▸ Pyrite Money Bracelets</a></li>
          <li><a href="/collections/zodiac-bracelets" style="color: inherit; text-decoration: none;">▸ Rashi & Zodiac Crystals</a></li>
        </ul>

        <a href="/collections/gemstones" class="devatva-gold-btn" style="margin-top: auto; padding: 10px; font-size: 0.85rem;">
          Explore Gemstones ➔
        </a>
      </div>

      <!-- Category 5: Pyramids, Yantras & Pooja Essentials -->
      <div style="background: #ffffff; border: 1.5px solid var(--dev-gold-border); border-radius: 18px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: all 0.3s ease; display: flex; flex-direction: column;" class="devatva-category-card">
        <div style="font-size: 2.8rem; margin-bottom: 12px; line-height: 1;">🪔</div>
        <h3 class="devatva-heading" style="font-size: 1.25rem; color: #1c1917; margin-bottom: 8px;">Pyramids & Yantras</h3>
        <p style="font-size: 0.84rem; color: #57534e; line-height: 1.45; margin-bottom: 16px;">Energized brass Yantras, Orgone pyramids, Sphatik malas, and home temple idols.</p>

        <ul style="list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.85rem; color: var(--dev-gold-dark); display: flex; flex-direction: column; gap: 6px;">
          <li><a href="/collections/brass-yantras" style="color: inherit; text-decoration: none;">▸ Shree & Kubera Yantras</a></li>
          <li><a href="/collections/crystal-pyramids" style="color: inherit; text-decoration: none;">▸ Orgone Crystal Pyramids</a></li>
          <li><a href="/collections/sphatik-malas" style="color: inherit; text-decoration: none;">▸ Sphatik & Sandal Malas</a></li>
          <li><a href="/collections/pooja-essentials" style="color: inherit; text-decoration: none;">▸ God Idols & Pooja Items</a></li>
        </ul>

        <a href="/collections/pooja-yantras" class="devatva-gold-btn" style="margin-top: auto; padding: 10px; font-size: 0.85rem;">
          Explore Yantras ➔
        </a>
      </div>

    </div>

  </div>
</div>

