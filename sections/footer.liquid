{% comment %}
  DEVATVA.IN - SACRED LUXURY FOOTER SECTION (OS 2.0 - LIGHT EDITION)
{% endcomment %}

<footer style="background: linear-gradient(180deg, #fdfbf7 0%, #f7f2e6 100%); border-top: 1.5px solid var(--dev-gold-border); padding: 65px 20px 30px 20px; color: var(--dev-text-main);">
  <div style="max-width: 1250px; margin: 0 auto;">
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 40px; margin-bottom: 50px;">
      
      <!-- Col 1: Brand Story & Sacred Commitment -->
      <div>
        <div style="margin-bottom: 12px;">
          <img
            src="{{ 'divyatva-logo-transparent.png' | asset_url }}"
            alt="Devatva Logo"
            style="max-width: 145px; height: auto; object-fit: contain; mix-blend-mode: multiply; display: block;"
            width="145"
            height="50"
          >
        </div>
        <p style="font-size: 0.9rem; color: #57534e; line-height: 1.65; margin-bottom: 20px;">
          Worldwide provider of 100% authentic, Govt. Lab-Certified Rudraksha beads, Panchdhatu wealth rings, and healing gemstone jewelry sanctified via Kashi Vedic rituals (Pran Pratishtha).
        </p>

        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <span class="devatva-badge devatva-badge-glowing">📜 Lab Certified</span>
          <span class="devatva-badge devatva-badge-glowing">🪔 Kashi Energized</span>
        </div>
      </div>

      <!-- Col 2: Sacred Collections -->
      <div>
        <h4 class="devatva-heading" style="font-size: 1.1rem; color: var(--dev-gold-dark); margin-bottom: 16px;">
          Sacred Collections
        </h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.9rem;">
          <li><a href="{{ routes.all_products_collection_url }}/rudraksha" style="color: #57534e; text-decoration: none; transition: color 0.2s;">🔱 Siddha Rudraksha Bracelets</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/rings" style="color: #57534e; text-decoration: none; transition: color 0.2s;">💰 Panchdhatu Pixiu Wealth Rings</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/kadas" style="color: #57534e; text-decoration: none; transition: color 0.2s;">⚡ Pure Copper Mahadev Kadas</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/gemstones" style="color: #57534e; text-decoration: none; transition: color 0.2s;">🔮 7 Chakra & Healing Crystals</a></li>
          <li><a href="{{ routes.all_products_collection_url }}/yantras" style="color: #57534e; text-decoration: none; transition: color 0.2s;">📿 Sphatik & Sandalwood Malas</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Devotion & Legal Policies -->
      <div>
        <h4 class="devatva-heading" style="font-size: 1.1rem; color: var(--dev-gold-dark); margin-bottom: 16px;">
          Policies & Support
        </h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.9rem;">
          <li><a href="/pages/privacy-policy" style="color: #57534e; text-decoration: none; transition: color 0.2s;">🛡️ Privacy Policy</a></li>
          <li><a href="/pages/refund-policy" style="color: #57534e; text-decoration: none; transition: color 0.2s;">🔄 Refund & Return Policy</a></li>
          <li><a href="/pages/terms-conditions" style="color: #57534e; text-decoration: none; transition: color 0.2s;">📜 Terms & Conditions</a></li>
          <li><a href="javascript:void(0)" onclick="DevatvaChatbot.toggle()" style="color: #57534e; text-decoration: none;">📦 Track Your Order Status</a></li>
          <li><a href="javascript:void(0)" onclick="DevatvaChatbot.setTab('callback'); DevatvaChatbot.toggle()" style="color: #57534e; text-decoration: none;">📞 Request Vedic Priest Call</a></li>
          <li><a href="javascript:void(0)" onclick="DevatvaChatbot.toggle()" style="color: #57534e; text-decoration: none;">🙏 Contact Us (24/7 Support)</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter & Blessings -->
      <div>
        <h4 class="devatva-heading" style="font-size: 1.1rem; color: var(--dev-gold-dark); margin-bottom: 16px;">
          Receive Daily Blessings
        </h4>
        <p style="font-size: 0.88rem; color: #57534e; margin-bottom: 14px; line-height: 1.5;">
          Subscribe for daily Vedic chanting mantras, astrological insights, and exclusive devotee offers.
        </p>

        <form onsubmit="event.preventDefault(); Devatva.showToast('Pranam! You are subscribed for daily blessings.');" style="display: flex; gap: 8px; margin-bottom: 16px;">
          <input
            type="email"
            placeholder="Enter your email..."
            required
            style="flex: 1; padding: 10px 14px; border: 1.5px solid #efe9dc; border-radius: 25px; background: #ffffff; color: #1c1917; font-size: 0.88rem; outline: none;"
          />
          <button type="submit" class="devatva-gold-btn" style="padding: 10px 20px; font-size: 0.85rem;">
            Subscribe
          </button>
        </form>

        <div style="font-size: 0.78rem; color: #047857; display: flex; align-items: center; gap: 6px; font-weight: 600;">
          <span>💵 Cash on Delivery (COD) Available Across All Pincodes</span>
        </div>
      </div>

    </div>

    <!-- Bottom Footer Bar -->
    <div style="border-top: 1px solid #efe9dc; padding-top: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; font-size: 0.82rem; color: #78716c;">
      <div>
        © {{ 'now' | date: '%Y' }} <strong>Devatva.in</strong>. All Sacred Rights Reserved. Sanctified in Kashi, India.
      </div>
      <div style="display: flex; gap: 12px; font-size: 0.8rem;">
        <span>🔒 256-Bit SSL Encrypted</span>
        <span>•</span>
        <span>📜 Govt Registered</span>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Devatva Footer",
  "settings": [],
  "presets": [
    {
      "name": "Devatva Footer"
    }
  ]
}
{% endschema %}
