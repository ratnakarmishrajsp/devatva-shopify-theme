{% comment %}
  DEVATVA.IN - SACRED ASTRO & GEM MATCHMAKER QUIZ SECTION (OS 2.0)
{% endcomment %}

<div id="devatva-astro-quiz-section" style="padding: 70px 20px; background: var(--dev-bg-surface); border-bottom: 1px solid var(--dev-gold-border); position: relative;">
  <div style="max-width: 900px; margin: 0 auto;">
    
    <div style="text-align: center; margin-bottom: 36px;">
      <span class="devatva-badge" style="margin-bottom: 10px;">🔮 Vedic Astrology & Gem Recommendation Engine</span>
      <h2 class="devatva-heading" style="font-size: clamp(1.8rem, 4vw, 2.6rem); color: #ffffff; margin-bottom: 12px;">
        Find Your Sacred <span class="devatva-gold-text">Astrological Remedy</span>
      </h2>
      <p style="color: var(--dev-text-muted); font-size: 1rem; max-width: 600px; margin: 0 auto;">
        Answer 3 simple questions about your life goals and Rashi to receive customized Vedic item recommendations.
      </p>
    </div>

    <!-- Interactive Quiz Box Container -->
    <div style="background: var(--dev-bg-card); border: 1px solid var(--dev-gold-main); border-radius: 20px; padding: 32px; box-shadow: 0 10px 40px rgba(0,0,0,0.8), var(--dev-shadow-gold);">
      
      <!-- Progress Bar Indicator -->
      <div style="width: 100%; height: 6px; background: rgba(255,255,255,0.1); border-radius: 10px; margin-bottom: 24px; overflow: hidden;">
        <div id="devatva-quiz-progress" style="width: 33%; height: 100%; background: linear-gradient(90deg, #f59e0b, #fbbf24); transition: width 0.4s ease;"></div>
      </div>

      <!-- Dynamic Step Render Container -->
      <div id="devatva-quiz-body">
        <!-- Rendered dynamically by assets/devatva-astro-quiz.js -->
      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Devatva Astro Matchmaker",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Find Your Sacred Astrological Remedy"
    }
  ],
  "presets": [
    {
      "name": "Devatva Astro Matchmaker"
    }
  ]
}
{% endschema %}
