{% comment %}
  DEVATVA.IN - SACRED ASTRO & GEM MATCHMAKER QUIZ SECTION (OS 2.0 - LIGHT EDITION)
{% endcomment %}

<div id="devatva-astro-quiz-section" style="padding: 75px 20px; background: #fffcf7; border-bottom: 1px solid var(--dev-gold-border); position: relative;">
  <div style="max-width: 920px; margin: 0 auto;">
    
    <div style="text-align: center; margin-bottom: 38px;">
      <span class="devatva-badge" style="margin-bottom: 12px;">🔮 Vedic Astrology & Gem Recommendation Engine</span>
      <h2 class="devatva-heading" style="font-size: clamp(1.8rem, 4vw, 2.7rem); color: #1c1917; margin-bottom: 12px;">
        Find Your Sacred <span class="devatva-gold-text">Astrological Remedy</span>
      </h2>
      <p style="color: #57534e; font-size: 1.02rem; max-width: 620px; margin: 0 auto;">
        Answer 3 simple questions about your life goals and Rashi to receive customized Vedic item recommendations.
      </p>
    </div>

    <!-- Interactive Light Quiz Box Container -->
    <div style="background: #ffffff; border: 1.5px solid var(--dev-gold-border); border-radius: 22px; padding: 34px; box-shadow: 0 15px 40px rgba(180, 83, 9, 0.08);">
      
      <!-- Progress Bar Indicator -->
      <div style="width: 100%; height: 7px; background: #f3eee3; border-radius: 10px; margin-bottom: 26px; overflow: hidden;">
        <div id="devatva-quiz-progress" style="width: 33%; height: 100%; background: linear-gradient(90deg, #d97706, #f59e0b); transition: width 0.4s ease;"></div>
      </div>

      <!-- Dynamic Step Render Container -->
      <div id="devatva-quiz-body">
        <!-- Rendered dynamically by assets/devatva-astro-quiz.js -->
      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Devatva Astro Matchmaker",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Find Your Sacred Astrological Remedy"
    }
  ],
  "presets": [
    {
      "name": "Devatva Astro Matchmaker"
    }
  ]
}
{% endschema %}
