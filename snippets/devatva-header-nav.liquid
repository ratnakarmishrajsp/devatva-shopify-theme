{% comment %}
  DEVATVA.IN - DYNAMIC MAIN HEADER NAVIGATION (SHOPIFY BACKEND LINKLIST & CLEAN FALLBACK)
{% endcomment %}

{%- assign main_menu = section.settings.menu | default: linklists['main-menu'] -%}

<nav class="devatva-header-nav" aria-label="Main Navigation">
  <ul class="devatva-main-menu">
    {%- if main_menu != blank and main_menu.links.size > 0 -%}
      {%- for link in main_menu.links -%}
        {%- if link.links != blank -%}
          <li class="devatva-has-dropdown">
            <a href="{{ link.url }}" class="devatva-menu-link">
              {{ link.title | escape }} <span class="devatva-arrow">▾</span>
            </a>
            <ul class="devatva-dropdown">
              {%- for childlink in link.links -%}
                <li>
                  <a href="{{ childlink.url }}">{{ childlink.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </li>
        {%- else -%}
          <li>
            <a href="{{ link.url }}" class="devatva-menu-link">{{ link.title | escape }}</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <!-- DEFAULT FALLBACK MAIN MENU ITEMS -->
      <li><a href="/" class="devatva-menu-link">Home</a></li>
      <li><a href="/collections/crystal-bracelets" class="devatva-menu-link">Crystal Braceletes</a></li>
      <li><a href="/collections/frames" class="devatva-menu-link">Frames</a></li>
      <li><a href="/collections/pixiu-rings" class="devatva-menu-link">Pixiu Rings</a></li>
      <li><a href="/collections/pyramids" class="devatva-menu-link">Pyramids</a></li>
      <li><a href="/collections/rudrakshas-and-karungalis" class="devatva-menu-link">Rudrakshas and Karungalis</a></li>
    {%- endif -%}
  </ul>
</nav>

<style>
.devatva-header-nav {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  padding: 8px 0;
}
.devatva-main-menu {
  display: flex;
  list-style: none;
  margin: 0 auto;
  padding: 0;
  gap: 24px;
  align-items: center;
  flex-wrap: nowrap;
  white-space: nowrap;
}
.devatva-menu-link {
  font-family: 'Plus Jakarta Sans', 'Outfit', sans-serif !important;
  font-size: 1.35rem !important;
  font-weight: 700 !important;
  letter-spacing: 0.04em !important;
  text-transform: uppercase !important;
  color: #1c1917 !important;
  text-decoration: none;
  padding: 8px 16px;
  border-radius: 20px;
  transition: all 0.25s ease;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
}
.devatva-menu-link:hover {
  color: var(--dev-gold-dark);
  background: #fff8e6;
}
.devatva-has-dropdown {
  position: relative;
}
.devatva-arrow {
  font-size: 0.75rem;
  transition: transform 0.2s ease;
}
.devatva-has-dropdown:hover .devatva-arrow {
  transform: rotate(180deg);
}
.devatva-dropdown {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%) translateY(10px);
  min-width: 230px;
  background: #ffffff;
  border: 1.5px solid var(--dev-gold-border);
  border-radius: 14px;
  padding: 10px 0;
  margin: 6px 0 0 0;
  list-style: none;
  box-shadow: 0 15px 35px rgba(217, 119, 6, 0.16);
  opacity: 0;
  pointer-events: none;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 999;
  text-align: left;
}
.devatva-has-dropdown:hover .devatva-dropdown {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}
.devatva-dropdown li a {
  display: block;
  padding: 10px 22px;
  font-size: 0.88rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  color: #292524;
  text-decoration: none;
  white-space: nowrap;
  transition: all 0.2s ease;
}
.devatva-dropdown li a:hover {
  background: #fff8e6;
  color: var(--dev-gold-dark);
  padding-left: 26px;
}
@media (max-width: 989px) {
  .devatva-header-nav {
    display: none !important;
  }
}
</style>
