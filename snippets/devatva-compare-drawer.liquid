{% comment %}
  DEVATVA.IN - SIDE-BY-SIDE COMPARE DRAWER
  Side drawer displaying side-by-side specs comparison for up to 3 products
{% endcomment %}

<div id="devatva-compare-drawer" class="devatva-drawer">
  <div class="devatva-drawer-header">
    <div style="display: flex; align-items: center; gap: 8px;">
      <span style="font-size: 1.4rem;">⚖️</span>
      <h3 class="devatva-heading" style="font-size: 1.15rem; margin: 0; color: var(--dev-gold-light);">
        Sacred Product Comparison
      </h3>
    </div>
    <button type="button" onclick="Devatva.closeCompare()" class="devatva-modal-close" style="position: static;">✕</button>
  </div>

  <div class="devatva-drawer-body">
    <div id="devatva-compare-content">
      <!-- Dynamically filled by Devatva.renderCompareDrawer() -->
    </div>
  </div>

  <div style="padding: 16px; border-top: 1px solid var(--dev-gold-border); background: rgba(0,0,0,0.5); display: flex; justify-content: space-between; align-items: center;">
    <span style="font-size: 0.8rem; color: var(--dev-text-muted);">Max 3 items compared simultaneously</span>
    <button type="button" onclick="Devatva.closeCompare()" class="devatva-outline-btn" style="padding: 8px 16px; font-size: 0.85rem;">
      Close Drawer
    </button>
  </div>
</div>
